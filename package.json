{
  "name": "app",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && turbo run typecheck && turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "turbo run db:generate --filter=@app/schema",
    "db:migrate": "turbo run db:migrate --filter=admin",
    "db:migrate:remote": "turbo run db:migrate:remote --filter=admin"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.9.0",
    "eslint-import-resolver-typescript": "^4.4.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.0",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.3.0",
    "typescript-eslint": "^8.68.0"
  }
}
