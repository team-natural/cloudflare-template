---
// Reference for how a member-only PAGE authenticates: it redirects rather than answering 401,
// and guards per-page (middleware.ts does security headers only).
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import LogoutButton from "../../lib/components/logout-button.svelte";
import { getSession } from "$lib/server/auth/session";
import { getMemberByPublicId, toPublicMember } from "$lib/server/services/members";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/login", 302);

// getSession already joined members, so a miss here means the row vanished mid-request.
const row = await getMemberByPublicId(db, session.memberPublicId);
if (!row) return Astro.redirect("/login", 302);
const member = toPublicMember(row);
---

<Layout title="My page">
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col gap-8 p-6">
    <header class="flex items-center justify-between gap-4">
      <h1 class="text-2xl font-bold">My page</h1>
      <LogoutButton client:load />
    </header>

    <section class="grid gap-2 text-sm">
      <p><span class="text-gray-500">Signed in as</span> {member.name} ({member.email})</p>
    </section>
  </main>
</Layout>
