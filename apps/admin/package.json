{
  "name": "admin",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "NODE_OPTIONS=--dns-result-order=ipv4first astro build",
    "preview": "astro preview",
    "typecheck": "wrangler types && astro check",
    "db:migrate": "wrangler d1 migrations apply DB --local --persist-to ../../.wrangler-state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed-user.mjs"
  },
  "dependencies": {
    "@app/schema": "workspace:*",
    "@app/server-kit": "workspace:*",
    "@astrojs/cloudflare": "^14.0.0",
    "@astrojs/svelte": "^9.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.37.0",
    "astro": "^7.0.0",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.0",
    "drizzle-zod": "^0.8.3",
    "svelte": "^5.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "shadcn-svelte": "^1.5.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
