---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found — Admin console">
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col items-center justify-center gap-4 px-4 text-center">
    <p translate="no" class="font-mono text-sm font-medium tracking-widest text-muted-foreground">404</p>
    <h1 class="text-3xl font-bold">Page not found</h1>
    <p class="text-muted-foreground">The page you are looking for doesn't exist or has been moved.</p>
    <a href="/" class="rounded-lg bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90">Back to sign in</a>
  </main>
</Layout>
