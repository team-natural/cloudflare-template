{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "cloudflare-template-admin",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },

  // vars is non-inheritable, so it's repeated in each env block below.
  "vars": {
    "SESSION_TTL_DAYS": "30",
    "AUTH_LOCKOUT_MAX_ATTEMPTS": "5",
    "AUTH_LOCKOUT_MINUTES": "15",
  },

  // Shared with apps/public: create once, then copy the ids into both. They must match —
  // database_id also keys the shared local sqlite file. KV is admin-only.
  // migrations_dir is non-inheritable, like vars above.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-db-name",
      "database_id": "replace-with-database-id",
      "migrations_dir": "../../packages/schema/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "replace-with-bucket-name",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "replace-with-kv-namespace-id",
    },
  ],

  "env": {
    "staging": {
      "vars": {
        "SESSION_TTL_DAYS": "30",
        "AUTH_LOCKOUT_MAX_ATTEMPTS": "5",
        "AUTH_LOCKOUT_MINUTES": "15",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "replace-with-db-name-staging",
          "database_id": "replace-with-database-id-staging",
          "migrations_dir": "../../packages/schema/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "replace-with-bucket-name-staging" }],
      "kv_namespaces": [{ "binding": "KV", "id": "replace-with-kv-namespace-id-staging" }],
    },
    "production": {
      "vars": {
        "SESSION_TTL_DAYS": "30",
        "AUTH_LOCKOUT_MAX_ATTEMPTS": "5",
        "AUTH_LOCKOUT_MINUTES": "15",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "replace-with-db-name-production",
          "database_id": "replace-with-database-id-production",
          "migrations_dir": "../../packages/schema/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "replace-with-bucket-name-production" }],
      "kv_namespaces": [{ "binding": "KV", "id": "replace-with-kv-namespace-id-production" }],
    },
  },
}
