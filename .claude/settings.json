{
  "enabledMcpjsonServers": [
    "context7",
    "context-mode",
    "semble"
  ],
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "mcp__context7"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-and-check.sh\"",
            "timeout": 120,
            "statusMessage": "Auto-formatting edited file (Prettier → ESLint → typecheck)..."
          }
        ]
      }
    ]
  }
}
